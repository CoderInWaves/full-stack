# MCP-Guard Environment Variables
# Copy this to .env and fill in values as needed.

# For HTTP authentication, run `mcp-guard hash-token` and store its output.
# Keep the token itself in the MCP client, not in this config file.
# MCP_GUARD_CLIENT_TOKEN_HASH=sha256:<64-hex-digest>

# Optional separate upstream credential. Configure it under http.upstream_headers.
# MCP_GUARD_UPSTREAM_TOKEN=replace-with-a-high-entropy-token

# Log level
# MCP_GUARD_LOG_LEVEL=INFO
